{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": { "EXPO_PUBLIC_USE_MOCK_API": "false", "EXPO_PUBLIC_API_BASE_URL": "https://REPLACE-WITH-YOUR-SERVICE-URL" }
    },
    "preview-android": {
      "extends": "preview",
      "android": { "buildType": "apk" }
    },
    "preview-ios": {
      "extends": "preview",
      "ios": { "simulator": false }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": { "production": {} }
}
